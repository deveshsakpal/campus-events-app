# ==============================================================================
# Campus Events & Registration - Environment Configuration Example
# Copy values into your local environment or Render Dashboard.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# Backend Spring Boot & PostgreSQL Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/campus_events
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-local-postgres-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=28800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Initial Bootstrap Admin Account (created safely on first API start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_NAME=Campus Events Admin

# Frontend React Portal (admin/) Configuration
VITE_API_BASE_URL=http://localhost:8080

# Frontend Flutter Student App (mobile/) Configuration
API_BASE_URL=http://localhost:8080
